{
  "name": "ironbark-ridge-esg",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "seed": "tsx src/scripts/seed.ts",
    "ingest": "tsx src/scripts/ingest.ts",
    "enrich": "tsx src/scripts/enrich.ts",
    "evaluate": "tsx src/scripts/evaluate.ts",
    "dev": "tsx watch src/scripts/serve.ts",
