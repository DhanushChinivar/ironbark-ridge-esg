    "hono": "^4.9.6",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@hono/node-server": "^1.19.1",
    "@types/node": "^20.19.0",
    "drizzle-kit": "^0.31.10",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
