# Neon Postgres connection string (pooled).
# Neon console -> your project -> Connection Details -> "Pooled connection"
DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/dbname?sslmode=require

# Anthropic API key, used only by the offline enrichment job (npm run enrich).
# The API and frontend never call the model at request time.
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx

# Model pinned so classification results are reproducible and versioned in the DB.
ANTHROPIC_MODEL=claude-sonnet-5

# Local API port (ignored on Vercel).
PORT=3000
